# Copy to .env for local development. Never commit .env.

# --- ODK Central ---
ODK_BASE_URL=            # e.g. https://odk.example.org
ODK_USERNAME=            # ODK Central account email
ODK_PASSWORD=            # ODK Central account password

# --- 121 platform ---
URL_121=                 # e.g. https://staging.121.global
USERNAME_121=            # 121 service account username
PASSWORD_121=            # 121 service account password

# --- Azure Key Vault (prod only, optional) ---
# In the `prod` environment, any credential above that is left empty is fetched from this vault,
# under the same name with dashes instead of underscores (ODK_BASE_URL -> ODK-BASE-URL).
# Authentication uses DefaultAzureCredential (managed identity in Azure, `az login` locally).
AZURE_KEY_VAULT_URL=     # e.g. https://my-vault.vault.azure.net

# --- Telemetry (optional) ---
# Set to ship logs to the Log Analytics workspace behind an Application Insights
# resource. Leave empty and the pipeline logs to the console only.
APPLICATIONINSIGHTS_CONNECTION_STRING=
