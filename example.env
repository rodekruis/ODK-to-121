# Copy to .env for local development. Never commit .env.

# --- ODK Central ---
ODK_BASE_URL=            # e.g. https://odk.example.org
ODK_USERNAME=            # ODK Central account email
ODK_PASSWORD=            # ODK Central account password

# --- 121 platform ---
URL_121=                 # e.g. https://staging.121.global
USERNAME_121=            # 121 service account username
PASSWORD_121=            # 121 service account password

# --- Telemetry (optional) ---
# Set to ship logs to the Log Analytics workspace behind an Application Insights
# resource. Leave empty and the pipeline logs to the console only.
APPLICATIONINSIGHTS_CONNECTION_STRING=
